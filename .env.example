DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.build/DB/auth
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Enable after configuring your own Google OAuth client in Neon Auth.
GOOGLE_AUTH_ENABLED=false
# Show the email sign-in/register affordances on the landing (email +
# password, email + one-time code, and two-factor management in Settings).
# The flows only succeed when the Neon Auth project has email sign-in and
# email delivery enabled on the service side; the UI degrades honestly when
# a method is unavailable.
EMAIL_AUTH_ENABLED=false

# Optional AI coach. Set AI_API_KEY and AI_MODEL to enable it; leaving either
# blank keeps the rest of the app working with AI hidden.
# OpenAI-compatible endpoint. Localhost/127.0.0.1 HTTP is allowed for local
# development only. A localhost URL is not reachable from Vercel.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Wire protocol spoken at AI_BASE_URL. One of: openai-responses,
# openai-chat (default, matches the original behavior), openai-completions
# (legacy), anthropic-messages (uses x-api-key + anthropic-version headers).
AI_PROTOCOL=openai-chat
# Credential style: bearer (default), anthropic-key, or none (local no-auth
# servers such as Ollama; AI_API_KEY may then stay blank).
AI_AUTH_MODE=
# Optional relative path overrides. Defaults follow the protocol
# (chat/completions, responses, completions, messages; models for discovery).
# Paths must be relative — they cannot change the host.
AI_GENERATION_PATH=
AI_MODELS_PATH=
# Some compatible providers reject response_format; set to false for those.
AI_JSON_MODE=true
AI_DAILY_REQUEST_LIMIT=30
AI_DAILY_TOKEN_LIMIT=300000
# Thinking models spend output tokens on hidden reasoning before the answer,
# so keep the cap generous (1200 starves them into empty replies). Providers
# bill only tokens actually generated.
AI_MAX_OUTPUT_TOKENS=8000
# Provider timeout in ms. This is the whole-call wall clock for non-streaming
# completions and the stall limit between stream chunks; thinking models need
# more than a trivial request. Keep it within your platform function limit
# (60s on Vercel) or raise maxDuration on the AI routes to match.
AI_TIMEOUT_MS=120000



# Required only if users may enter their own API key in the web UI
# (Settings -> AI provider, or inside the AI panel).
#
# This secret encrypts those keys with AES-256-GCM before they are stored, so a
# database-only leak yields ciphertext. Use 64 hex characters (openssl rand
# -hex 32) or a >=32-character passphrase. Losing it makes every stored
# credential unreadable; rotating it requires re-entering each key.
#
# Leaving this blank is safe: AI then works only from the AI_API_KEY above, and
# the in-app credential form reports that storage is unavailable.
AI_CREDENTIAL_SECRET=

# Scheduled Trash cleanup. `vercel.json` points a daily cron at
# /api/cron/trash-cleanup; Vercel sends this value as `Authorization: Bearer
# <CRON_SECRET>`. Generate one with `openssl rand -hex 32`.
#
# Leaving this blank is safe but disables physical cleanup: the endpoint
# answers 503 and expired Trash rows simply stay on disk. Restoring and
# listing them is already blocked by the API once the 15-day window closes,
# so the only consequence is storage, never a wrong answer.
#
# Any external scheduler can drive the same endpoint with the same header.
CRON_SECRET=

# Upstash Redis — cross-instance rate limiting (optional).
#
# Without these two variables the app runs on the in-memory limiter only: each
# serverless instance enforces its own bucket, so the effective global limit is
# (limit x warm instances). That is fine for local development, CI, and a
# single-instance deployment. Add both to get one shared limit across instances.
#
# Free tier shaping: reads never spend a Redis command; only writes and AI
# calls consult Upstash, and a per-instance daily budget (soft 8000 / hard 9500
# commands) degrades back to in-memory before the 10k/day allowance is gone.
# If Upstash is unreachable, a circuit breaker opens after 3 failures and every
# request falls back to the in-memory limiter. Rate limiting can never take the
# app down.
#
# Create a database at https://console.upstash.com and copy its REST URL and
# token. Never expose the token to the browser; it has no NEXT_PUBLIC_ prefix.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
